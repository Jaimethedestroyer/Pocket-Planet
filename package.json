{
  "name": "pocket-planet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A persistent 3D civilization simulation on a living planet.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "shot": "node tools/shots.mjs",
    "soak": "tsx tools/soak.ts",
    "probe": "tsx tools/probe-terrain.ts",
    "history": "tsx tools/history.ts",
    "verify-save": "node tools/verify-save.mjs",
    "verify-motion": "node tools/verify-motion.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.169.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
